    artist: '<a href="//commons.wikimedia.org/w/index.php?title=User:Chainsawpunk&amp;action=edit&amp;redlink=1" class="new" title="User:Chainsawpunk (page does not exist)">Chainsawpunk</a>',
    description: 'Goats in front of Avenue of the Baobabs'
  }
